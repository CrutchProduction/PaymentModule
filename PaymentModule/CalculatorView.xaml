<UserControl
    x:Class="PaymentModule.CalculatorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource SystemControlHighlightAccent2RevealBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{ThemeResource SystemControlHighlightAccent2RevealBackgroundBrush}"
            BorderThickness="2" CornerRadius="10" Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="16" Padding="0,0,16,16">
                <TextBlock Text="Калькулятор предусловий" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Спланируйте расходы и задайте желаемый результат. Предусловие покажет, что должно быть верно до выполнения вашего сценария."/>
                <Button Content="Как пользоваться" Click="Help_Click" HorizontalAlignment="Left"/>

                <ComboBox x:Name="ScenarioPicker" Header="Выберите финансовый сценарий"
                          FontSize="20" CornerRadius="10" HorizontalAlignment="Stretch"
                          SelectionChanged="Scenario_SelectionChanged">
                    <ComboBoxItem Content="Серия платежей — последовательность присваиваний"/>
                    <ComboBoxItem Content="Резерв на расходы — максимум из двух"/>
                    <ComboBoxItem Content="Бюджет заказа — квадратное уравнение"/>
                </ComboBox>

                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="ScenarioTitle" FontSize="28" FontWeight="Light"/>
                        <TextBlock x:Name="ScenarioDescription"/>
                        <TextBlock x:Name="ScenarioVariables" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="1. Укажите исходные данные" FontSize="28" FontWeight="Light"/>
                <TextBox x:Name="ScenarioBalance" Header="Текущий баланс для сценария, ₽" Text="30000"
                         ToolTipService.ToolTip="Учебное значение. Его изменение не меняет реальный счёт."/>
                <TextBlock Text="Баланс вводится вручную и относится только к сценарию. Счёт в шапке не изменяется."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBox x:Name="ScenarioTarget" Header="Желаемый остаток после платежей, ₽" Text="5000"/>

                <TextBlock Text="2. Опишите желаемый результат" FontSize="28" FontWeight="Light"/>
                <TextBox x:Name="PostInput" Header="Цель (Post) — условие после выполнения кода"
                         TextWrapping="Wrap" AutomationProperties.Name="Цель Post"/>
                <TextBox x:Name="PostDescription" Header="Цель словами" TextWrapping="Wrap"/>
                <TextBlock x:Name="PostHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <TextBlock Text="3. Задайте операции" FontSize="28" FontWeight="Light"/>
                <TextBox x:Name="CodeInput" Header="Код финансового сценария"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="190" FontFamily="Consolas"
                         AutomationProperties.Name="Код финансового сценария"/>
                <TextBlock Text="Каждая строка описывает действие. balance — баланс. Присваивания и if / else вводятся без циклов."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Button Content="Рассчитать условие" IsEnabled="False" HorizontalAlignment="Left"/>
                <TextBlock Text="Сейчас доступен интерфейс с примерами. Расчёт ещё не подключён; поля не синхронизируются автоматически."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Результат планирования" FontSize="28" FontWeight="Light"/>
                        <TextBlock x:Name="ResultCaption" Text="Необходимая сумма на счёте"/>
                        <TextBlock Text="— ₽" FontSize="30" Foreground="#4ADE80"/>
                        <TextBlock x:Name="DifferenceCaption" Text="Сколько не хватает"/>
                        <TextBlock Text="— ₽" FontSize="30"/>
                        <TextBlock Text="Результат пока не рассчитан." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Expander Header="Как получено условие" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Пошаговые преобразования" FontSize="28" FontWeight="Light"/>
                        <TextBlock Text="Постусловие рассматривается от последнего оператора к первому. Здесь появятся промежуточные условия."/>
                        <TextBox Header="Итоговое предусловие (wp)" IsReadOnly="True" PlaceholderText="Пока не рассчитано" TextWrapping="Wrap"/>
                        <TextBox Header="Объяснение словами" IsReadOnly="True" PlaceholderText="Пояснение результата" TextWrapping="Wrap"/>
                        <TextBlock Text="Условия определённости" FontSize="28" FontWeight="Light"/>
                        <TextBlock Text="Здесь будут показаны ограничения: например, знаменатель не равен нулю, а подкоренное выражение неотрицательно."/>
                        <TextBlock Text="Триада Хоара" FontSize="28" FontWeight="Light"/>
                        <TextBlock Text="{}{ Предусловие } → Код сценария → { Постусловие }"/>
                        <TextBlock Text="Если начальные данные удовлетворяют предусловию, выполнение сценария должно обеспечить заданную цель."/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
