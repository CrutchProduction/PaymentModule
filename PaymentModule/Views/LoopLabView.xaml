<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PaymentModule.Views.LoopLabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PaymentModule.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:ConditionBrushConverter x:Key="ConditionBrush" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:CellStateBrushConverter x:Key="CellStateBrush" />
        <converters:CurrentStepBrushConverter x:Key="CurrentStepBrush" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource SystemControlHighlightAccent2RevealBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Formula" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="900" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{ThemeResource SystemControlHighlightAccent2RevealBackgroundBrush}"
            BorderThickness="2" CornerRadius="10" Padding="20">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel MinWidth="1100" Spacing="16">
                <TextBlock Text="Анализ будущих платежей" FontSize="30" FontWeight="Bold" />
                <TextBlock Style="{StaticResource Label}"
                           Text="Введите суммы платежей, выберите расчёт и нажмите «Рассчитать». Учебная проверка цикла спрятана в блоке ниже." />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--платежи-->
                    <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Платежи" Style="{StaticResource CardTitle}" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <NumberBox Header="Платежей" Value="{Binding PaymentCount, Mode=TwoWay}"
                                           Minimum="1" Maximum="24" SpinButtonPlacementMode="Compact" />
                                <NumberBox Grid.Column="1" Header="Мин, ₽" Value="{Binding MinAmount, Mode=TwoWay}"
                                           Minimum="0" Maximum="1000000" SpinButtonPlacementMode="Compact" />
                                <NumberBox Grid.Column="2" Header="Макс, ₽" Value="{Binding MaxAmount, Mode=TwoWay}"
                                           Minimum="0" Maximum="1000000" SpinButtonPlacementMode="Compact" />
                            </Grid>

                            <Button Content="Заполнить случайными суммами" Command="{Binding GenerateCommand}"
                                    HorizontalAlignment="Left" />

                            <Grid ColumnSpacing="8" Padding="4,8,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="#" Style="{StaticResource Label}" />
                                <TextBlock Grid.Column="1" Text="Платёж, ₽" Style="{StaticResource Label}" />
                                <TextBlock Grid.Column="2" Text="&gt; T" Style="{StaticResource Label}" Visibility="{Binding IsCountMode, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>

                            <ListView ItemsSource="{Binding Payments}" MaxHeight="250" SelectionMode="None"
                                      HorizontalContentAlignment="Stretch">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="4"
                                                Background="{Binding State, Converter={StaticResource CellStateBrush}}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="34" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Number}" FontSize="14"
                                                           VerticalAlignment="Center" />
                                                <NumberBox Grid.Column="1" Value="{Binding Value, Mode=TwoWay}"
                                                           Minimum="0" Maximum="1000000" FontSize="14" Height="32"
                                                           MinWidth="0" SpinButtonPlacementMode="Hidden" />
                                                <TextBlock Grid.Column="2" Text="&gt; T" FontSize="12"
                                                           Foreground="#F87171" VerticalAlignment="Center"
                                                           Visibility="{Binding AboveThreshold, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock Style="{StaticResource Label}"
                                       Text="Суммы можно менять прямо в таблице. Поле «Платежей» задаёт количество строк." />
                        </StackPanel>
                    </Border>

                    <!--расчёт-->
                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Расчёт" Style="{StaticResource CardTitle}" />

                            <ComboBox Header="Что считаем?" SelectedIndex="{Binding SelectedModeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Общая сумма платежей" />
                                <ComboBoxItem Content="Количество платежей больше суммы" />
                                <ComboBoxItem Content="Самый крупный платёж" />
                            </ComboBox>

                            <NumberBox Header="Считать платежи больше, ₽" Value="{Binding Threshold, Mode=TwoWay}"
                                       Minimum="0" Maximum="1000000" SpinButtonPlacementMode="Compact"
                                       Visibility="{Binding IsCountMode, Converter={StaticResource BoolToVisibility}}" />

                            <Button Content="Рассчитать" Command="{Binding CalculateCommand}"
                                    HorizontalAlignment="Left" />

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="10" Padding="16">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Результат" Style="{StaticResource Label}" />
                                    <TextBlock Text="{Binding ResultText}" FontSize="24" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource Label}"
                                       Text="После расчёта история шагов сохранится — её можно посмотреть в блоке «Проверка корректности расчёта»." />
                        </StackPanel>
                    </Border>
                </Grid>

                <Expander Header="Проверка корректности расчёта" IsExpanded="False"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                        <Grid ColumnSpacing="16" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--история шагов-->
                            <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="История шагов" Style="{StaticResource CardTitle}" FontSize="20" />

                                    <Grid ColumnSpacing="8" Padding="6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Шаг" Style="{StaticResource Label}" />
                                        <TextBlock Grid.Column="1" Text="Платёж" Style="{StaticResource Label}" />
                                        <TextBlock Grid.Column="2" Text="Итог" Style="{StaticResource Label}" />
                                        <TextBlock Grid.Column="3" Text="Инв. до" Style="{StaticResource Label}" />
                                        <TextBlock Grid.Column="4" Text="Инв. после" Style="{StaticResource Label}" />
                                        <TextBlock Grid.Column="5" Text="t" Style="{StaticResource Label}" />
                                        <TextBlock Grid.Column="6" Text="t ok" Style="{StaticResource Label}" />
                                    </Grid>

                                    <ListView ItemsSource="{Binding Steps}" MaxHeight="320" SelectionMode="None"
                                              HorizontalContentAlignment="Stretch">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Padding="6,4"
                                                        Background="{Binding IsCurrent, Converter={StaticResource CurrentStepBrush}}">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="40" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Title}" FontSize="12" />
                                                        <TextBlock Grid.Column="1" Text="{Binding PaymentText}" FontSize="12" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ResultText}" FontSize="12" />
                                                        <TextBlock Grid.Column="3" Text="{Binding InvBeforeText}" FontSize="12"
                                                                   Foreground="{Binding InvBeforeOk, Converter={StaticResource ConditionBrush}}" />
                                                        <TextBlock Grid.Column="4" Text="{Binding InvAfterText}" FontSize="12"
                                                                   Foreground="{Binding InvAfterOk, Converter={StaticResource ConditionBrush}}" />
                                                        <TextBlock Grid.Column="5" Text="{Binding VariantText}" FontSize="12" />
                                                        <TextBlock Grid.Column="6" Text="{Binding VariantCheckText}" FontSize="12"
                                                                   Foreground="{Binding VariantOk, Converter={StaticResource ConditionBrush}}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <TextBlock Style="{StaticResource Label}"
                                               Text="{Binding HistoryHint}" />
                                </StackPanel>
                            </Border>

                            <!--пошаговый просмотр-->
                            <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Пошаговый просмотр" Style="{StaticResource CardTitle}" FontSize="20" />

                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            CornerRadius="8" Padding="8">
                                        <TextBlock Text="{Binding CodeText}" FontFamily="Consolas" FontSize="12"
                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </Border>

                                    <TextBox Header="Инвариант словами" Text="{Binding InvariantWords, Mode=TwoWay}"
                                             AcceptsReturn="True" TextWrapping="Wrap" Height="56" FontSize="13"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    <TextBox Header="Инвариант (формула)" Text="{Binding InvariantFormula, Mode=TwoWay}"
                                             FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" />
                                    <TextBox Header="Вариант-функция t" Text="{Binding VariantFormula, Mode=TwoWay}"
                                             FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" />

                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            CornerRadius="8" Padding="10">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding CurrentStepTitle}" FontSize="16" FontWeight="SemiBold" />

                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Платёж" Style="{StaticResource Label}" />
                                                    <TextBlock Text="{Binding CurrentPaymentText}" FontSize="16" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Текущий итог" Style="{StaticResource Label}" />
                                                    <TextBlock Text="{Binding CurrentResultText}" FontSize="16" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Width="12" Height="12" CornerRadius="6" VerticalAlignment="Center"
                                                            Background="{Binding InvBefore, Converter={StaticResource ConditionBrush}}" />
                                                    <TextBlock Text="Инвариант до шага:" FontSize="13" />
                                                    <TextBlock Text="{Binding CurrentInvBeforeText}" FontSize="13"
                                                               Foreground="{Binding InvBefore, Converter={StaticResource ConditionBrush}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                    <Border Width="12" Height="12" CornerRadius="6" VerticalAlignment="Center"
                                                            Background="{Binding InvAfter, Converter={StaticResource ConditionBrush}}" />
                                                    <TextBlock Text="после шага:" FontSize="13" />
                                                    <TextBlock Text="{Binding CurrentInvAfterText}" FontSize="13"
                                                               Foreground="{Binding InvAfter, Converter={StaticResource ConditionBrush}}" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="{Binding CurrentVariantText}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CurrentVariantStatus}" Style="{StaticResource Label}" />

                                            <ProgressBar Minimum="0" Maximum="{Binding VariantMax}"
                                                         Value="{Binding VariantValue}"
                                                         Foreground="{Binding VariantOk, Converter={StaticResource ConditionBrush}}" />
                                            <TextBlock Text="{Binding VariantText}" Style="{StaticResource Label}" />

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Шаг" Command="{Binding StepCommand}"
                                                        IsEnabled="{Binding HasResult}" />
                                                <Button Content="{Binding RunButtonText}" Command="{Binding RunCommand}"
                                                        IsEnabled="{Binding HasResult}" />
                                                <Button Content="Сброс" Command="{Binding ResetCommand}"
                                                        IsEnabled="{Binding HasResult}" />
                                            </StackPanel>

                                            <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                    CornerRadius="8" Padding="10"
                                                    Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Border Width="14" Height="14" CornerRadius="7" VerticalAlignment="Center"
                                                            Background="{Binding PostHolds, Converter={StaticResource ConditionBrush}}" />
                                                    <TextBlock Text="{Binding PostStatusText}" TextWrapping="Wrap" FontSize="13" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!--четыре условия-->
                        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Четыре условия корректности" Style="{StaticResource CardTitle}" FontSize="20" />
                                <TextBlock Text="{Binding SpecText}" Style="{StaticResource Formula}" />

                                <ItemsControl ItemsSource="{Binding Proofs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                      Margin="0,2,0,2">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border Width="12" Height="12" CornerRadius="6"
                                                                VerticalAlignment="Center"
                                                                Background="{Binding StatusBrush}" />
                                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding StatusText}" FontSize="15" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="{Binding Formula}" Style="{StaticResource Formula}" />
                                                    <TextBlock Text="{Binding Explanation}" FontSize="13" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding WpInvariant}" Style="{StaticResource Formula}" />
                                <TextBlock Text="{Binding WpVariant}" Style="{StaticResource Formula}" />
                                <TextBlock Text="{Binding DefText}" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding WpResultText}" Style="{StaticResource Label}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
