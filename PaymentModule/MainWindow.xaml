    </Border>
                    <Border x:Name="PhotoPanel" Grid.Column="1" CornerRadius="10" Visibility="Collapsed">
                        <Image x:Name="CalculatorPhoto" Source="ms-appx:///Assets/CalculatorPhoto.jpg" Stretch="Uniform"
                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                               AutomationProperties.AccessibilityView="Raw"/>
                    </Border>
                    <Button x:Name="TogglePhotoButton" Grid.Column="1" Width="24" Height="24"
                            MinWidth="0" MinHeight="0" Padding="0" Opacity="0" IsTabStop="False"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            AutomationProperties.Name="Скрыть или показать фото и лазеры"
                            Click="TogglePhotoButton_Click"/>
</Grid>

            </TabViewItem>
        </TabView>
        <Border x:Name="About" Grid.Row="1" BorderBrush="{ThemeResource SystemControlHighlightAccent2RevealBackgroundBrush}" BorderThickness="2" CornerRadius="10" Background="Transparent"  Padding="20" Visibility="Collapsed">
            <Grid>
                <StackPanel Spacing="8">

                    <TextBlock Text="Платёжный модуль" FontSize="24" FontWeight="Bold"/>

                    <TextBlock Text="Назначение" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0"/>
                    <TextBlock Text="Приложение моделирует работу банковского платёжного модуля и позволяет выполнять четыре операции:" TextWrapping="Wrap"/>
                    <TextBlock Text="перевод на другой счёт, перевод в другую валюту, пополнение и снятие средств." TextWrapping="Wrap"/>

                    <TextBlock Text="Технологии" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0"/>
                    <TextBlock Text="• Язык: C# (.NET 8)"/>
                    <TextBlock Text="• UI: WinUI 3"/>
                    <TextBlock Text="• Архитектура: MVVM"/>
                    <TextBlock Text="• Тестирование: xUnit"/>

                    <TextBlock Text="Контрактный подход" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0"/>
                    <TextBlock Text="Каждая операция имеет формально описанные предусловия (Pre) и постусловия (Post)." TextWrapping="Wrap"/>
                    <TextBlock Text="Их выполнение отображается в интерфейсе цветными индикаторами," TextWrapping="Wrap"/>
                    <TextBlock Text="а полное описание доступно по кнопке «Показать контракт»." TextWrapping="Wrap"/>

                    <TextBlock Text="Разработчик" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0"/>
                    <TextBlock Text="CrutchProduction"/>

                </StackPanel>
            </Grid>
            
        </Border>
        <Canvas x:Name="LaserOverlay" Grid.RowSpan="2" Canvas.ZIndex="100"
                IsHitTestVisible="False" Opacity="0"/>
    </Grid>
</Window>

