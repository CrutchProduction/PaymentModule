                                            <Button.Flyout>
                                                <Flyout>
                                                    <TextBlock Style="{StaticResource HintText}" Text="Сколько должен получить получатель. Комиссия списывается дополнительно. В коде эта сумма обозначается amount." />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                    <Grid Style="{StaticResource CalculatorInputRow}" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="CommissionPercent" Header="Комиссия, %" PlaceholderText="percent = " />
                                        <Button Grid.Column="1" Style="{StaticResource HelpButton}" AutomationProperties.Name="Подсказка: процент комиссии">
                                            <Button.Flyout>
                                                <Flyout>
                                                    <TextBlock Style="{StaticResource HintText}" Text="Процент от суммы перевода по вашему тарифу. Например, введите 1 для комиссии 1%. В коде — percent. Поля не подставляются в код автоматически." />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                    <Grid Style="{StaticResource CalculatorInputRow}" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="MinimumCommission" Header="Минимальная комиссия, ₽" PlaceholderText="minFee = " />
                                        <Button Grid.Column="1" Style="{StaticResource HelpButton}" AutomationProperties.Name="Подсказка: минимальная комиссия">
                                            <Button.Flyout>
                                                <Flyout>
                                                    <TextBlock Style="{StaticResource HintText}" Text="Минимальная плата за перевод по тарифу. Из процента от перевода и этой суммы выбирается большее — они не складываются. В коде — minFee. Если минимума нет, укажите 0." />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                                <Grid Style="{StaticResource CalculatorInputRow}" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PostInput" Header="Цель (Post)" PlaceholderText="Введите условие" TextWrapping="Wrap" />
                                    <Button Grid.Column="1" Style="{StaticResource HelpButton}" AutomationProperties.Name="Подсказка: цель Post">
                                        <Button.Flyout>
                                            <Flyout>
                                                <TextBlock Style="{StaticResource HintText}" x:Name="PostHint" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                                <Grid Style="{StaticResource CalculatorInputRow}" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PostDescription" Header="Цель словами" PlaceholderText="Опишите нужный результат" TextWrapping="Wrap" AcceptsReturn="True" Height="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                                    <Button Grid.Column="1" Style="{StaticResource HelpButton}" AutomationProperties.Name="Подсказка: цель словами">
                                        <Button.Flyout>
                                            <Flyout>
                                                <TextBlock Style="{StaticResource HintText}" Text="Объясните условие обычными словами. Например: после всех расходов осталось не менее 5 000 ₽." />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                                <Grid Style="{StaticResource CalculatorInputRow}" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CodeInput" Header="Код расчёта" PlaceholderText="Введите операции" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="190" FontFamily="Consolas" AutomationProperties.Name="Код финансового сценария" />
                                    <Button Grid.Column="1" Style="{StaticResource HelpButton}" AutomationProperties.Name="Подсказка: код сценария">
                                        <Button.Flyout>
                                            <Flyout>
                                                <TextBlock x:Name="CodeHint" Style="{StaticResource HintText}" Text="Каждая строка — действие. Например, balance = balance - 20000; означает расход 20 000 ₽. Можно использовать присваивания и if / else без циклов. Готовый образец доступен по кнопке «Заполнить пример»." />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                                <InfoBar x:Name="CalculationError" IsOpen="False" Severity="Error" IsClosable="True" Title="Не удалось выполнить расчёт" />
                                <Button x:Name="CalculateWP" Content="Рассчитать условие" IsEnabled="True" HorizontalAlignment="Left" Click="CalculateWP_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Grid Grid.Column="1">
                        <Border x:Name="CalculationResultsPanel" BorderBrush="{ThemeResource SystemControlHighlightAccent2RevealBackgroundBrush}" BorderThickness="2" CornerRadius="10" Padding="20">
                            <ScrollViewer x:Name="CalculatorResultsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="20" Padding="0,0,12,16">
                                    <TextBlock Text="Результат расчёта" FontSize="30" FontWeight="Bold" />
                                    <Border Style="{StaticResource SectionBorder}">
                                        <StackPanel Spacing="12">
                                            <TextBlock x:Name="ResultCaption" Text="Необходимая сумма на счёте" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="ResultValue" Text="— ₽" FontSize="28" FontWeight="Normal" Foreground="#4ADE80" IsTextSelectionEnabled="True" />
                                            <TextBlock x:Name="DifferenceCaption" Text="Сколько не хватает" Margin="0,8,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="DifferenceValue" Text="— ₽" FontSize="28" IsTextSelectionEnabled="True" FontWeight="Normal" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="CalculationResultHint" Text="Заполните поля слева и нажмите «Рассчитать условие»." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Expander x:Name="CalculationDetails" Header="Как получено условие" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <StackPanel Spacing="16">
                                            <TextBlock Text="Пошаговые преобразования" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock x:Name="CalculationSteps" Text="Шаги появятся после расчёта." FontSize="20" IsTextSelectionEnabled="True" />
                                            <TextBox x:Name="CalculationPrecondition" Header="Предусловие (wp)" Width="Auto" HorizontalAlignment="Stretch" IsReadOnly="True" PlaceholderText="Пока не рассчитано" TextWrapping="Wrap" FontSize="20" />
                                            <TextBlock Text="Условия определённости" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock x:Name="CalculationDefinedness" Text="Ограничения появятся после расчёта." FontSize="20" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="Триада Хоара" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock x:Name="CalculationHoare" Text="Предусловие → Код → Постусловие" FontSize="20" IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border x:Name="PhotoPanel" CornerRadius="10" Visibility="Collapsed">
                            <Image x:Name="CalculatorPhoto" Source="ms-appx:///Assets/CalculatorPhoto.jpg" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.AccessibilityView="Raw" />
                        </Border>
                        <Button x:Name="TogglePhotoButton" Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" Margin="4" Opacity="0" IsTabStop="False" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="Скрыть или показать фото и лазеры" Click="TogglePhotoButton_Click" />
                    </Grid>
                </Grid>
            </TabViewItem>
        </TabView>
        <Border x:Name="About" Grid.Row="1" BorderBrush="{ThemeResource SystemControlHighlightAccent2RevealBackgroundBrush}" BorderThickness="2" CornerRadius="10" Background="Transparent"  Padding="20" Visibility="Collapsed">
            <Grid>
                <StackPanel Spacing="8">

                    <TextBlock Text="Платёжный модуль" FontSize="24" FontWeight="Bold"/>

                    <TextBlock Text="Назначение" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0"/>
                    <TextBlock Text="Приложение моделирует работу банковского платёжного модуля и позволяет выполнять четыре операции:" TextWrapping="Wrap"/>
                    <TextBlock Text="перевод на другой счёт, перевод в другую валюту, пополнение и снятие средств." TextWrapping="Wrap"/>

                    <TextBlock Text="Технологии" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0"/>
                    <TextBlock Text="• Язык: C# (.NET 8)"/>
                    <TextBlock Text="• UI: WinUI 3"/>
                    <TextBlock Text="• Архитектура: MVVM"/>
                    <TextBlock Text="• Тестирование: xUnit"/>

                    <TextBlock Text="Контрактный подход" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0"/>
                    <TextBlock Text="Каждая операция имеет формально описанные предусловия (Pre) и постусловия (Post)." TextWrapping="Wrap"/>
                    <TextBlock Text="Их выполнение отображается в интерфейсе цветными индикаторами," TextWrapping="Wrap"/>
                    <TextBlock Text="а полное описание доступно по кнопке «Показать контракт»." TextWrapping="Wrap"/>

                    <TextBlock Text="Разработчик" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0"/>
                    <TextBlock Text="CrutchProduction"/>

                </StackPanel>
            </Grid>
            
        </Border>
        <Canvas x:Name="LaserOverlay" Grid.RowSpan="2" Canvas.ZIndex="100"
                IsHitTestVisible="False" Opacity="0"/>
    </Grid>
</Window>

